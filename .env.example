# Maw3ed local/VPS isolation
PORT=7000
VITE_PORT=7100
BACKEND_PORT=7000

# Use the existing isolated Postgres instance from LOCAL_ISOLATION_REPORT.md.
MAW3ED_STORAGE=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/maw3ed

# Optional integrations
# SESSION_SECRET=replace-with-a-long-random-value
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# MAW3ED_EMAIL_MODE=outbox