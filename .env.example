# Maw3ed environment files
#
# Only two modes are supported: local | production
#
# 1) Copy examples:
#      copy .env.local.example .env.local
#      copy .env.production.example .env.production
#      copy .env.mode.example .env.mode
#
# 2) Set active mode in .env.mode (local or production)
#    or export MAW3ED_ENV=local|production
#
# 3) Flow: edit locally → npm run update:all → git push → VPS pulls Git
#
# See: docs/ENVIRONMENTS.md · docs/LOCAL_CURSOR_WORKFLOW.md · docs/DEPLOY_VPS.md

MAW3ED_ENV=local
PORT=7000
VITE_PORT=7100
BACKEND_PORT=7000
MAW3ED_STORAGE=local
