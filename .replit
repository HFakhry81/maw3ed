modules = ["nodejs-20", "web", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
# Keep Maw3ed on 7000 so it can run beside UpNexa (5000), Fanni (3000), Spendi.
args = "PORT=7000 VITE_PORT=7100 BACKEND_PORT=7000 MAW3ED_STORAGE=memory npm start"
waitForPort = 7000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 7000
externalPort = 80

[[ports]]
localPort = 7100
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_72blC6FBd4F1OO"
MAW3ED_STORAGE = "memory"
