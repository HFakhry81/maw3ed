modules = ["nodejs-20", "web", "postgresql-16"]
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 MAW3ED_STORAGE=postgres npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 7000
externalPort = 3000

[[ports]]
localPort = 7100
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_72blC6FBd4F1OO"
MAW3ED_STORAGE = "postgres"
