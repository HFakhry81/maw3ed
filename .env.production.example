# Maw3ed — PRODUCTION environment (VPS)
# Copy to .env.production on the server. Never commit secrets.
#
# Activate: set MAW3ED_ENV=production   OR put "production" in .env.mode

MAW3ED_ENV=production

# Ports on the shared VPS (Nginx proxies here — never bind 5000 / UpNexa)
PORT=7000
BACKEND_PORT=7000
# VITE_PORT is unused in production (serve dist/ via Node)

# Production storage
MAW3ED_STORAGE=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/maw3ed

# Required secrets in production
SESSION_SECRET=replace-with-a-long-random-value

# Auth (Clerk) — use PRODUCTION keys only on the VPS
# Development: pk_test_ / sk_test_   ·   Production: pk_live_ / sk_live_
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional networkless JWT verify (PEM from Clerk Dashboard → API Keys → JWT public key)
# Use this if the VPS/VPN blocks api.clerk.com JWKS fetch:
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Public app URL (used for redirects / optional Clerk authorized parties)
APP_URL=https://maw3ed.upnexa-eg.com
# Optional comma-separated azp allow-list (only if Clerk JWT includes azp)
# CLERK_AUTHORIZED_PARTY=https://maw3ed.upnexa-eg.com

# Email: outbox for dry-run, SendGrid for VPS, or leave empty to try Gmail connector
# MAW3ED_EMAIL_MODE=outbox
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@your-domain.com
# MAIL_FROM_NAME=موعد Maw3ed

# Optional billing
# WHOP_COMPANY_ID=
