# Maw3ed — PRODUCTION environment (VPS)
# Copy to .env.production on the server. Never commit secrets.
#
# Activate: set MAW3ED_ENV=production   OR put "production" in .env.mode

MAW3ED_ENV=production

# Ports on the shared VPS (Nginx proxies here — never bind 5000 / UpNexa)
PORT=7000
BACKEND_PORT=7000
# VITE_PORT is unused in production (serve dist/ via Node)

# Production storage
MAW3ED_STORAGE=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/maw3ed

# Required secrets in production
SESSION_SECRET=replace-with-a-long-random-value

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Email: leave empty for live Gmail connector, or use outbox for dry-run
# MAW3ED_EMAIL_MODE=

# Optional billing
# WHOP_COMPANY_ID=
