# Maw3ed — LOCAL environment (development on Cursor Desktop)
# Copy to .env.local and adjust. Never commit secrets.
#
# Activate: set MAW3ED_ENV=local   OR put "local" in .env.mode

MAW3ED_ENV=local

# Ports (side-by-side with Fanni/UpNexa/Spendi — never use 5000)
PORT=7000
VITE_PORT=7100
BACKEND_PORT=7000

# Local default: in-memory / JSON ops (no Postgres required)
MAW3ED_STORAGE=local
# Optional local Postgres (only if you want SQL locally):
# MAW3ED_STORAGE=postgres
# DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/maw3ed

# Dev-safe secrets / integrations
SESSION_SECRET=local-dev-only-change-me
MAW3ED_EMAIL_MODE=outbox
# Optional live mail locally:
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@example.com

# Optional Clerk (leave empty for local ops without auth gate)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
