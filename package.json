{
  "name": "maw3ed-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "موعد Maw3ed — Arabic appointment platform by UpNexa-eg.com",
  "scripts": {
    "env:local": "node -e \"require('fs').writeFileSync('.env.mode','local\\n')\"",
    "env:production": "node -e \"require('fs').writeFileSync('.env.mode','production\\n')\"",
    "start": "npm run build && node --use-system-ca server.js",
    "start:local": "npm run env:local && npm start",
    "start:production": "npm run env:production && npm start",
    "dev:api": "node --use-system-ca server.js",
    "dev": "vite --host 0.0.0.0",
    "migrate": "node scripts/migrate.js",
    "migrate:dry-run": "node scripts/migrate.js --dry-run",
    "audit:ops-integrity": "node scripts/audit-ops-integrity.js",
    "compare:ops": "node scripts/compare-workspace-ops.js",
    "test:ops-integrity": "node scripts/smoke-ops-integrity.js",
    "test:staff-links": "node scripts/smoke-staff-links.js",
    "test:phase2-data": "npm run test:ops-integrity && npm run test:staff-links",
    "seed": "node scripts/seed.js",
    "seed:demo:restore": "node scripts/seed-demo-workspaces.js --restore",
    "seed:demo:save": "node scripts/seed-demo-workspaces.js --save",
    "users:cleanup-demo-owners": "node scripts/cleanup-demo-owner-users.js",
    "check:isolation": "node scripts/check-isolation.js",
    "check:staging": "node scripts/staging-acceptance.js",
    "ops:reset": "node scripts/reset-ops-data.js",
    "ops:backup": "node scripts/ops-session-backup.js --backup --reason=manual",
    "ops:restore": "node scripts/ops-session-backup.js --restore-latest",
    "ops:backups": "node scripts/ops-session-backup.js --list",
    "test:smoke": "node scripts/smoke-public-booking.js && node scripts/smoke-booking-governance.js && node scripts/smoke-workspace-isolation.js && node scripts/smoke-ops-rbac.js && node scripts/smoke-legacy-rbac.js && node scripts/smoke-bola.js && node scripts/smoke-workspace-events.js && node scripts/smoke-ops-integrity.js && node scripts/smoke-staff-links.js",
    "test:ops-rbac": "node scripts/smoke-ops-rbac.js",
    "test:legacy-rbac": "node scripts/smoke-legacy-rbac.js",
    "test:bola": "node scripts/smoke-bola.js",
    "test:workspace-events": "node scripts/smoke-workspace-events.js",
    "test:phase1-security": "npm run test:ops-rbac && npm run test:legacy-rbac && npm run test:bola && npm run test:workspace-events && npm run test:staff-links",
    "test:platform-admin": "node scripts/smoke-platform-admin.js",
    "platform-admin:bootstrap": "node scripts/bootstrap-platform-admin.js",
    "test:slug-resolve": "node scripts/smoke-slug-resolve.js",
    "test:http": "npm run test:slug-resolve && node scripts/smoke-http.js",
    "test:all": "npm run test:smoke && npm run test:http && npm run test:platform-admin",
    "refresh": "node scripts/refresh-all.js",
    "update:backend": "node scripts/update-targets.js backend",
    "update:api": "node scripts/update-targets.js api",
    "update:frontend": "node scripts/update-targets.js frontend",
    "update:web": "node scripts/update-targets.js web",
    "update:mobile": "node scripts/update-targets.js mobile",
    "update:all": "node scripts/update-targets.js all",
    "release:prepare": "node scripts/prepare-release.js",
    "change:start": "node scripts/development-log.js start",
    "change:stage": "node scripts/development-log.js stage",
    "change:finish": "node scripts/development-log.js finish",
    "change:watch": "node scripts/development-log.js watch",
    "change:report": "node scripts/development-log.js report",
    "build": "node scripts/build.js",
    "web:dist": "npm run build",
    "icons:png": "node scripts/export-icon-pngs.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/clerk-js": "^6.31.1",
    "@clerk/clerk-react": "^5.61.6",
    "@replit/connectors-sdk": "^0.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@whop/sdk": "^1.1.3",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "picomatch": "^4.0.4"
  }
}
