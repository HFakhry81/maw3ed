{
  "name": "maw3ed-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "لوحة تحكم منصة موعد",
  "scripts": {
    "start": "npm run build && if [ -f .env ]; then node --env-file=.env server.js; else node server.js; fi",
    "dev": "vite --host 0.0.0.0",
    "migrate": "if [ -f .env ]; then node --env-file=.env scripts/migrate.js; else node scripts/migrate.js; fi",
    "seed": "if [ -f .env ]; then node --env-file=.env scripts/seed.js; else node scripts/seed.js; fi",
    "change:start": "node scripts/development-log.js start",
    "change:stage": "node scripts/development-log.js stage",
    "change:finish": "node scripts/development-log.js finish",
    "change:watch": "node scripts/development-log.js watch",
    "change:report": "node scripts/development-log.js report",
    "build": "node scripts/build.js",
    "web:dist": "npm run build"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/clerk-js": "^6.31.1",
    "@replit/connectors-sdk": "^0.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@whop/sdk": "^1.1.3",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
